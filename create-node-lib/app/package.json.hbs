{
    "name": "{{name}}",
    "description": "{{description}}",
    "version": "{{version}}",
    "type": "module",
    "author": "{{author}}",
    "license": "MIT",
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/{{author}}/{{name}}.git"
    },
    "engines": {
        "node": ">= 24"
    },
    "scripts": {
        "build": "tsc --project tsconfig.build.json",
        "lint": "eslint",
        "format": "prettier --write \"**/*.+(js|ts)\"",
        "prepare": "husky",
        "test": "vitest --coverage",
        "clean": "rimraf dist"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.0.1",
        "@eslint/markdown": "^8.0.3",
        "@types/bun": "latest",
        "@types/lodash": "^4.17.24",
        "@types/mdast": "^4.0.4",
        "@typescript-eslint/eslint-plugin": "^8.63.0",
        "@vitest/coverage-v8": "4.1.10",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "lint-staged": "^17.0.8",
        "prettier": "^3.9.5",
        "rimraf": "^6.1.3",
        "tslint-config-prettier": "^1.18.0",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.63.0",
        "vitest": "^4.1.10"
    },
    "peerDependencies": {
        "typescript": "^5.9.2"
    },
    "dependencies": {
        "lodash": "^4.18.1",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3"
    },
    "lint-staged": {
        "*.{ts,tsx,mjs}": [
            "prettier --write",
            "eslint --max-warnings 0 ."
        ]
    }
}
