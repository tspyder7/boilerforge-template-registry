import { prompt } from 'enquirer';
import { PromptCompiler } from './prompt.compiler';
import { AppArguments } from '../../types/common';

export const dispatchPrompts = async (): Promise<AppArguments> => {
    const parser = new PromptCompiler();
    const promptConfig = await parser.parse();
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    return (await prompt(promptConfig as any)) as AppArguments;
};
