/* eslint-disable @typescript-eslint/no-explicit-any */
import { Command } from 'commander';

export type SemVersion =
    | `${number}.${number}.${number}`
    | `${number}.${number}.${number}-${string}`
    | `${number}.${number}.${number}+${string}`
    | `${number}.${number}.${number}-${string}+${string}`;

export type CLIConfiguration = {
    name: string;
    description: string;
    version: SemVersion;
};

type NormalizeDefault<T> = T extends boolean
    ? boolean
    : T extends number
      ? number
      : T extends string
        ? string
        : T;

type ExtractFlagName<S extends string> =
    S extends `${string}--${infer Long} ${string}`
        ? TrimKebab<Long>
        : S extends `${string}--${infer Long}`
          ? TrimKebab<Long>
          : S extends `${string}-${infer Short} ${string}`
            ? Short
            : S extends `${string}-${infer Short}`
              ? Short
              : never;

type TrimKebab<T extends string> = T extends `${infer Word},${string}`
    ? Word
    : T;

type KebabToCamel<S extends string> = S extends `${infer T}-${infer U}`
    ? `${T}${Capitalize<KebabToCamel<U>>}`
    : S;

export type FlagToCamel<S extends string> = KebabToCamel<ExtractFlagName<S>>;

export type InferOptions<T> = T extends { options: readonly any[] }
    ? {
          [O in T['options'][number] as FlagToCamel<O['flags']>]: O extends {
              default: infer D;
          }
              ? NormalizeDefault<D>
              : string;
      }
    : Record<string, CompositeCommand>;

export type CLIProps = CLIConfiguration;

export interface CommandHandler<T> {
    config: T;
    register(program: Command): void;
    action(args: string[], options: InferOptions<T>): void;
}

export type OptionDefinitions = Array<{
    flags: string;
    description: string;
    default?: string | string[] | boolean;
}>;

type CommandCategory = 'sub-cmd' | 'cmd-grp';

export enum CommandType {
    SUB_COMMAND = 'sub-cmd',
    COMMAND_GROUP = 'cmd-grp',
}

export interface CommandDefinition {
    type: CommandCategory;
    command: string;
    description: string;
}

export interface LeafCommand extends CommandDefinition {
    options?: OptionDefinitions;
}

export interface CompositeCommand extends CommandDefinition {
    subCommands: Array<new (...args: any[]) => CommandHandler<any>>;
}

export type CommandRegistry = Record<string, LeafCommand | CompositeCommand>;
