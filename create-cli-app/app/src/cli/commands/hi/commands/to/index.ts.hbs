import { InferOptions } from '../../../../../types/cli';
import SubCommands from '../../config';
import { CommandRegistrar } from '../../../../../core/cli/command-registrar';
import { logger } from '../../../../../utils/logger';

type Options = InferOptions<typeof SubCommands>;

export default class ToCommand extends CommandRegistrar<
    typeof SubCommands.TO
> {
    constructor() {
        super(SubCommands.TO);
    }

    // eslint-disable-next-line @typescript-eslint/no-unused-vars
    async action(args: string[], options: Options) {
        const [name] = args;
        logger.info(`Hi ${name} from {{name}}`);
    }
}
