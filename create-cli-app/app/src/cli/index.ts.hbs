import { CLI } from '../constants/cli.constants';
import { CommandBuilder } from '../core/cli/command-builder';
import * as SubCommands from './commands';

export const baseCommand = CommandBuilder.build({
    name: CLI.NAME,
    description: CLI.DESCRIPTION,
    version: CLI.VERSION,
});

Object.values(SubCommands).forEach((Cmd) => {
    const instance = new Cmd();
    instance.register(baseCommand);
});

export default baseCommand;
