function CompassMark({ className }: { className?: string }) {
  return (
    <svg viewBox="0 0 40 40" fill="none" aria-hidden="true" className={className}>
      <circle cx="20" cy="20" r="18.25" stroke="currentColor" strokeWidth="1.4" />
      <path d="M20 8l3.5 12L20 32l-3.5-12L20 8Z" fill="currentColor" />
      <circle cx="20" cy="20" r="2.2" className="fill-paper" />
      <path d="M7.5 20h5M27.5 20h5" stroke="currentColor" strokeWidth="1.4" strokeLinecap="round" />
    </svg>
  );
}

function PlanetShape({ size, color, ring }: { size: number; color: string; ring: boolean }) {
  return (
    <>
      <circle r={size * 2.2} className={color} opacity="0.12" />
      <circle r={size} className={color} />
      {ring ? (
        <ellipse
          rx={size * 2.6}
          ry={size * 0.85}
          fill="none"
          stroke="currentColor"
          className="stroke-orbit-accent"
          strokeWidth="1.4"
          opacity="0.65"
          transform="rotate(-22)"
        />
      ) : null}
    </>
  );
}

function OrbitVisual() {
  return (
    <div className="relative mx-auto w-full max-w-[620px]">
      <div
        className="pointer-events-none absolute left-1/2 top-1/2 size-[72%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-orbit-core opacity-[0.05] blur-3xl"
        aria-hidden="true"
      />
      <svg
        viewBox="0 0 640 460"
        className="relative w-full"
        role="img"
        aria-label="Decorative animation of planets orbiting along concentric circles"
      >
        <defs>
          <radialGradient id="core-glow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stopColor="var(--orbit-core)" stopOpacity="var(--orbit-glow-opacity)" />
            <stop offset="100%" stopColor="var(--orbit-core)" stopOpacity="0" />
          </radialGradient>
          <radialGradient id="sun-glow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stopColor="var(--orbit-core)" stopOpacity="var(--sun-glow-opacity)" />
            <stop offset="45%" stopColor="var(--orbit-core)" stopOpacity="calc(var(--sun-glow-opacity) * 0.3)" />
            <stop offset="100%" stopColor="var(--orbit-core)" stopOpacity="0" />
          </radialGradient>
        </defs>

        <g className="fill-ink" opacity="0.35">
          {stars.map((star) => (
            <circle key={`${star.x}-${star.y}`} cx={star.x} cy={star.y} r={star.r} className="twinkle" style=\{{ animationDelay: `${star.delay}s` }} />
          ))}
        </g>

        <circle cx={CENTER_X} cy={CENTER_Y} r="232" fill="url(#core-glow)" />
        <circle cx={CENTER_X} cy={CENTER_Y} r="150" fill="url(#sun-glow)" />

        <g fill="none" stroke="currentColor">
          {orbits.map((orbit, index) => (
            <circle
              key={orbit.radius}
              cx={CENTER_X}
              cy={CENTER_Y}
              r={orbit.radius}
              className={index === 2 ? 'text-orbit-accent' : 'text-orbit-line'}
              strokeWidth={index === 2 ? 2.2 : 1.8}
              strokeDasharray={index % 2 === 1 ? '2 6' : undefined}
              opacity={index === 2 ? 0.6 : 0.9}
            />
          ))}
        </g>

        <circle cx={CENTER_X} cy={CENTER_Y} r="34" className="fill-orbit-core" opacity="0.9" />

        <g className="orbit-motion">
          {orbits.map((orbit) => {
            const path = `M ${CENTER_X} ${CENTER_Y} m -${orbit.radius} 0 a ${orbit.radius} ${orbit.radius} 0 1 0 ${orbit.radius * 2} 0 a ${orbit.radius} ${orbit.radius} 0 1 0 -${orbit.radius * 2} 0`;

            return (
              <g key={orbit.radius}>
                <animateMotion dur={`${orbit.duration}s`} begin={`${orbit.offset}s`} repeatCount="indefinite" path={path} />
                <PlanetShape size={orbit.size} color={orbit.color} ring={orbit.ring} />
              </g>
            );
          })}
        </g>

        <g className="orbit-static">
          {orbits.map((orbit) => {
            const radians = (orbit.angle * Math.PI) / 180;

            return (
              <g
                key={orbit.radius}
                transform={`translate(${CENTER_X + orbit.radius * Math.cos(radians)} ${CENTER_Y + orbit.radius * Math.sin(radians)})`}
              >
                <PlanetShape size={orbit.size} color={orbit.color} ring={orbit.ring} />
              </g>
            );
          })}
        </g>
      </svg>
    </div>
  );
}

