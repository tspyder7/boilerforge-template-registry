'use client';

import { Moon, Sun } from 'lucide-react';

export function ThemeToggle() {
  function toggleTheme() {
    const root = document.documentElement;
    const next = root.classList.contains('dark') ? 'light' : 'dark';

    root.classList.toggle('dark', next === 'dark');

    try {
      localStorage.setItem('ostia-theme', next);
    } catch {
      // Storage can be unavailable in private or locked-down browsing contexts.
    }
  }

  return (
    <button
      type="button"
      onClick={toggleTheme}
      aria-label="Toggle color theme"
      title="Toggle color theme"
      className="group grid size-10 place-items-center rounded-full border border-line bg-paper/70 text-muted backdrop-blur transition-colors hover:border-ink/25 hover:text-ink"
    >
      <Sun className="size-4 transition-transform group-hover:rotate-45 dark:hidden" strokeWidth={1.6} aria-hidden="true" />
      <Moon className="hidden size-4 transition-transform group-hover:-rotate-12 dark:block" strokeWidth={1.6} aria-hidden="true" />
    </button>
  );
}
